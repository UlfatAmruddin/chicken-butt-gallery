# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
# Replace gallery.example.com with your real domain (DNS A/AAAA record must
# already point at this server). Caddy obtains and renews the TLS cert for you.
#
# Install Caddy, drop this at /etc/caddy/Caddyfile, then: sudo systemctl reload caddy

gallery.example.com {
	encode gzip zstd
	# Shed oversized requests at the proxy before they reach Node. 24MB covers the
	# largest legitimate body: a profile update with both an 8MB avatar AND an 8MB
	# cover is ~21.3MB after base64 expansion (a 12MB photo is only ~16MB).
	request_body {
		max_size 24MB
	}
	reverse_proxy 127.0.0.1:8173 {
		header_up X-Forwarded-For {remote_host}
	}
}
