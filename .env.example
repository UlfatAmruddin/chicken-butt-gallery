# Copy to .env for local dev, or set these as Environment Variables on your host.
# On Render add them under Environment (never commit real values).

# --- Persistence driver ---
# 'file' (default) stores data in data/*.json on local disk - fine for local dev
# and any host with a persistent disk. 'supabase' stores each collection as a
# JSONB blob in a Supabase Postgres table (what production uses).
STORE_DRIVER=file
# Table name for the KV blobs (see DEPLOY.md for the CREATE TABLE). Default: kv
# SUPABASE_KV_TABLE=kv

# --- Supabase (Storage for uploads + the KV data table when STORE_DRIVER=supabase) ---
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_KEY=your-service-role-key      # server-only SECRET, never expose to the client
# SUPABASE_BUCKET=photos

# --- Supabase Auth (Google sign-in) ---
# REQUIRED for login. This is the PUBLIC anon / publishable key - a different key from
# SUPABASE_KEY above. It is served to the browser by GET /api/config on purpose; that is
# how Supabase is designed. Pasting the SERVICE-ROLE key here would hand every visitor
# full database access, so the server refuses to serve a key that looks secret.
# SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# The site owner's Google address. On first Google sign-in this account is linked to the
# reserved admin username, so the owner keeps ownership of existing communities. The link
# additionally requires a CONFIRMED email from the trusted provider, so a matching address
# alone cannot claim admin. Without this, the owner signs in as an ordinary new user.
# ADMIN_EMAIL=owner@example.com
# Trusted provider for that link (default: google).
# ADMIN_PROVIDER=google

# --- Behind a reverse proxy (Render and most PaaS) set this to 1 so rate limits
# key off the real client IP from X-Forwarded-For. Leave unset for direct local dev.
# TRUST_PROXY=1
# Only set this when a real Cloudflare edge fronts the app. Without one (the current
# setup) CF-Connecting-IP is raw client input and trusting it would
# let anyone rotate their rate-limit key.
# TRUST_CF_IP=1

# --- Local dev only ---
# PORT=8173
