# Copy to .env and adjust for your deployment. All values have safe defaults;
# nothing here is required for local development.

# --- Network ---
# Bind address. Keep 127.0.0.1 in production so only the reverse proxy can reach
# Node. Use 0.0.0.0 only if you intentionally expose the port (not recommended).
HOST=127.0.0.1
PORT=8173

# Set to 1 ONLY when a trusted reverse proxy (Caddy/nginx) sits in front and sets
# X-Forwarded-For. If 1 without a proxy, clients can spoof their IP and dodge
# rate limits. Leave 0 for direct/local runs.
TRUST_PROXY=1

# Send HTTP Strict-Transport-Security (takes effect once served over HTTPS).
ENABLE_HSTS=1

# --- Identity / auth ---
# Comma-separated global superadmins (bypass all community membership checks).
ADMIN_USERNAMES=your_username
MIN_PASSWORD_LEN=8
SESSION_TTL_DAYS=30

# --- Rate limiting ---
AUTH_WINDOW_MIN=10
AUTH_MAX_ATTEMPTS=25
WRITE_WINDOW_MIN=5
WRITE_MAX=300
UPLOAD_WINDOW_MIN=10
UPLOAD_MAX=40

# --- Email + 2FA ---
# Leave RESEND_API_KEY empty for DEV MODE: codes are printed to the server log
# instead of emailed (good for local testing). Set it to send real email via
# Resend (https://resend.com). MAIL_FROM must be a verified sender on your domain
# for delivery to real inboxes; the resend.dev default only delivers to your own
# Resend account email during testing.
RESEND_API_KEY=
MAIL_FROM=Chicken Butt Gallery <onboarding@resend.dev>
APP_NAME=Chicken Butt Gallery
CODE_TTL_MIN=10
CODE_MAX_ATTEMPTS=5
CODE_SEND_WINDOW_MIN=15
CODE_SEND_MAX=5
DEVICE_TTL_DAYS=30

# --- Abuse caps ---
MAX_COMMUNITIES_PER_USER=25
MAX_PHOTOS_PER_USER=1000
MAX_COMMENTS_PER_POST=500
MAX_AUDIT_EVENTS=5000
MAX_IMAGE_MB=12

# --- Storage (optional) ---
# Point the JSON data dir at an external volume. Assets always live in <root>/assets.
# PG_DATA_DIR=/var/lib/chicken-gallery/data
